# Copie ce fichier en ".env". Ne commite JAMAIS le fichier .env.
PORT=8787

# ===== Choix du fournisseur d'IA : décommente UN des blocs =====

# --- 1) Claude (Anthropic) : meilleure qualité, payant à l'usage ---
PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
MODEL=claude-haiku-5-5

# --- 2) Ollama en local : gratuit, tourne sur ton PC (qualité selon le modèle) ---
# PROVIDER=openai
# OPENAI_BASE_URL=http://localhost:11434/v1
# MODEL=qwen2.5:3b

# --- 3) Google Gemini (offre gratuite limitée) : clé sur aistudio.google.com ---
# PROVIDER=openai
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# OPENAI_API_KEY=ta_cle_gemini
# MODEL=gemini-2.0-flash

# --- 4) Groq (offre gratuite limitée) : clé sur console.groq.com ---
# PROVIDER=openai
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_API_KEY=ta_cle_groq
# MODEL=llama-3.3-70b-versatile

# Limites par utilisateur et par jour
DAILY_CHAT_LIMIT=40
DAILY_FEEDBACK_LIMIT=10
IP_REQUESTS_PER_MIN=60

# Optionnel : secret de signature des jetons (sinon généré dans data/secret.txt)
# SERVER_SECRET=
